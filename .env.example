##############################################################################
#  MajstorKlik — Lead Generation Machine
#  Kopiraj u `.env.local` (Next.js) odnosno `.env` (worker) i popuni.
#  SVE ispod ima besplatan tier. Ništa se ne naplaćuje.
##############################################################################

# ---------------------------------------------------------------------------
# 1) AI PROVAJDERI — treba ti BAR JEDAN, a idealno sva tri (fallback lanac)
# ---------------------------------------------------------------------------

# PRIMARNI — ekstrakcija (najbrži, ~30 req/min besplatno)
# Ključ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=30
GROQ_RPD=14000

# SEKUNDARNI — scoring i pisanje poruka (15 req/min, 1500/dan besplatno)
# Ključ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_RPM=15
GEMINI_RPD=1400

# TERCIJARNI / FALLBACK — besplatni modeli, rotacija kad prva dva padnu
# Ključ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Zarezom odvojena lista; prazno = ugrađena lista besplatnih modela
OPENROUTER_MODELS=
OPENROUTER_SITE_URL=https://majstorklik.rs
OPENROUTER_SITE_NAME=MajstorKlik Lead Machine
OPENROUTER_RPM=18
OPENROUTER_RPD=900

# Koliko leadova AI obrađuje paralelno (free tier ne voli više od 3)
AI_CONCURRENCY=3

# ---------------------------------------------------------------------------
# 2) BAZA — Supabase (besplatan plan: 500MB, dovoljno za ~500.000 leadova)
#    https://supabase.com  ->  New project  ->  SQL Editor  ->  supabase/schema.sql
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE ROLE ključ — NIKAD ga ne stavljaj u kod koji ide u browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads
SUPABASE_RUNS_TABLE=harvest_runs

# ---------------------------------------------------------------------------
# 3) PRAGOVI KVALITETA
# ---------------------------------------------------------------------------
# Lead ispod ovog skora se ne upisuje. 45 = širok levak, 65 = samo ozbiljno.
MIN_LEAD_SCORE=55

# ---------------------------------------------------------------------------
# 4) SKREPER
# ---------------------------------------------------------------------------
SCRAPER_HEADLESS=true
SCRAPER_STORAGE_DIR=./.scraper-state
# Poštovanje robots.txt. Ostavi prazno/false — ovo ti čuva IP.
SCRAPER_IGNORE_ROBOTS=false
# Gde se snima JSON izvoz (rezerva kad nema baze)
EXPORT_DIR=./export

# Registri / direktorijumi stambenih zajednica (zarezom odvojeno, opciono)
REGISTAR_SZ_URLS=

# Oglasi za nekretnine — PODRAZUMEVANO ISKLJUČENO.
# Uključi tek kad proveriš uslove korišćenja izvora (vidi README, sekcija Pravni okvir).
OGLASI_ENABLED=false
OGLASI_ONLY_AGENCIES=true
OGLASI_MIN_PRICE_EUR=150000
# Šablon URL-a pretrage: {zona}, {cena}, {strana} se zamenjuju
OGLASI_BASE_URL=
# Ili puna konfiguracija više izvora kao JSON niz:
# OGLASI_SOURCES=[{"id":"x","label":"X","urlTemplate":"https://.../{zona}?strana={strana}","selectors":{"card":".ad","title":"h2","price":".price","location":".loc","link":"a"}}]

# ---------------------------------------------------------------------------
# 5) WORKER (Railway / Render) — kontinualno prikupljanje
# ---------------------------------------------------------------------------
WORKER_CRAFTS=vodoinstalater,gipsar,moler
WORKER_ACTIVE_FROM_HOUR=8
WORKER_ACTIVE_TO_HOUR=22
WORKER_MIN_PAUSE_MIN=45
WORKER_MAX_PAUSE_MIN=120
# Postavi na true SAMO tamo gde postoji Chromium (Railway/Render/VPS), nikad na Vercel-u
RUN_SCRAPER_HERE=false

# ---------------------------------------------------------------------------
# 6) API ZAŠTITA
# ---------------------------------------------------------------------------
# Nasumičan string: openssl rand -hex 32
API_TOKEN=
CRON_SECRET=
# URL workera kojem Vercel prosleđuje posao (npr. https://majstorklik-worker.up.railway.app)
WORKER_URL=
WORKER_TOKEN=

# ---------------------------------------------------------------------------
# 7) LOGOVANJE
# ---------------------------------------------------------------------------
LOG_LEVEL=info
